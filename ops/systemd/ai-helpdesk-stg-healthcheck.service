[Unit]
Description=AI HelpDesk Staging health + release binding check (read-only)
After=network-online.target ai-helpdesk-stg-api.service
Wants=ai-helpdesk-stg-api.service

[Service]
Type=oneshot
WorkingDirectory=__STG_ROOT__/current
Environment=AIHD_STG_ROOT=__STG_ROOT__
Environment=PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash __STG_ROOT__/current/scripts/stg-healthcheck.sh
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=60
