# アプリ設定（MVP）。実際の値は `.env.local`（Git 管理外）に置く。
NODE_ENV=development
PORT=18950
HOST=127.0.0.1

# Local PostgreSQL（専用 DB）。既存 DB は変更しない。
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5435/ai_helpdesk_mvp

# セッション署名/トークン用（十分な長さのランダム値）
SESSION_SECRET=replace-with-64-hex
# Worker → API の共有秘密（Worker Secret と一致させる）
PROXY_SECRET=replace-with-48-hex

# Seed 用のデモパスワード（リポジトリへコミットしない）
SEED_PASSWORD=replace-with-demo-password

# ブラウザの Origin（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Preview（HTTPS）では true
COOKIE_SECURE=false
LOG_LEVEL=info

# 認証: local（開発/テスト） / cloudflare-access（本番・Preview）
AUTH_MODE=local
DEV_AUTH_EMAIL=dev@example.com
# アクセス許可リストの正本（完全一致メール / @domain。repo ルート相対）
# Cloudflare Access の allow ポリシーと同じ内容にすること。
# 社外の個人メールを含む場合はリポジトリ外の絶対パスを指定する（公開リポジトリのため。docs/61）。
ACCESS_ALLOWLIST_FILE=docs/MailAddress.txt
# 「操作する人」の切替を許可するメール（カンマ区切り）。
# cloudflare-access（本番）では既定で本人以外に切り替えられない。デモ用だけ列挙する。
PERSONA_SWITCH_ALLOWLIST=
# 同一人物のメール別名（カンマ区切り `alias=primary`）。
# 例: Cloudflare Access で Gmail と会社アドレスを使い分ける人がいても、
# 状態・切替権限・名簿照合を primary に揃える。
EMAIL_ALIASES=

# 別アカウントだが同一人物の組（`a@x|b@y;c@z|d@w`）。正規化はせず、監査・応答に
# 「同一人物である」事実を残すためだけに使う（自己承認の誤読防止）。
# 例: kensan1969@gmail.com|k-aritoh@mirai-const.co.jp
SHARED_IDENTITY_GROUPS=

# 引継ぎの自己承認を許可するか（true / false。既定 true）。
# 本番が Cloudflare Access の実質1アイデンティティ運用の間は true にしないと、
# 自分の引継ぎを自分で引き受けて承認できず業務が止まる。
# 別 ID 運用（依頼者と担当者を分ける）へ移行し、職務分離を強制する場合は false。
# false のとき、引き受けた本人による approve は 403 SELF_APPROVAL_FORBIDDEN になる。
ALLOW_SELF_APPROVAL=true


# Cloudflare Access の JWT 検証: off / report（ログのみ） / enforce（不正なら 401）
ACCESS_JWT_MODE=off
# 例: <team>.cloudflareaccess.com（Access のチームドメイン）
ACCESS_TEAM_DOMAIN=
# Access アプリケーションの AUD タグ（秘密ではない）
ACCESS_AUD=

# DeepSeek API（MVP / Staging のみ。リポジトリへ書かない）
DEEPSEEK_API_KEY=
# DeepSeek-V4.1-Flash（API モデル ID: deepseek-flash）
DEEPSEEK_MODEL=deepseek-flash
# 一次回答の速度/安定性を優先する場合は disabled。推論を使う場合は enabled。
DEEPSEEK_THINKING=disabled
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=30000

# 最終報告書の PDF 生成（ヘッドレス Chrome）。通常は自動検出するため空でよい。
# 例: /usr/bin/google-chrome
REPORT_PDF_BIN=
REPORT_PDF_TIMEOUT_MS=30000

# RSP / MeshCentral（既存の遠隔操作基盤）。B さんの画面にリンクを表示する。
MESHCENTRAL_URL=https://mesh.mirai-remotetools.com/
RSP_BASE_URL=https://rsp.mirai-remotetools.com/
# Phase 1 遠隔対応: RSP のサービス認証キー（サーバ側のみ。ブラウザへ渡さない）
RSP_SERVICE_KEY=
# 担当者に返す RSP の公開 URL（ブラウザのリンク用）
RSP_PUBLIC_URL=https://rsp.mirai-remotetools.com

# --- 引継ぎのメール通知 -------------------------------------------------
# auto: SMTP_HOST があれば smtp、無ければ無効（sendmail は MAIL_TRANSPORT=sendmail で明示）。
# テスト（NODE_ENV=test）は既定で無効（実メールを送らない）。
MAIL_TRANSPORT=auto
# 差出人。組織のルールに合わせて実在するアドレスを指定する。
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# 465（SMTPS）を使う場合だけ true
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 個人指名が無いときの通知先（カンマ区切り。グループ受信箱など）
HANDOVER_NOTIFY_EMAIL=
# バックアップ失敗・ディスク残量の通知先（カンマ区切り）。空なら HANDOVER_NOTIFY_EMAIL へ送る。
OPS_ALERT_EMAIL=
# メールに載せる画面の URL
NOTIFY_BASE_URL=https://ai-helpdesk.mirai-dx-platform.com
# 送信キューの消化間隔（ミリ秒）
NOTIFY_INTERVAL_MS=30000

# 解決ループ: 端末オフライン判定（秒）。設計 §4-3 の既定は 2 分
RESOLVE_DEVICE_OFFLINE_SEC=120
# 解決ループ: リスク 4 以上の Skill を承認できる IT 管理者（カンマ区切り。空＝誰も承認不可）
RESOLVE_ADMIN_ALLOWLIST=

# --- 本人同意付きフォルダ一覧（docs/62）------------------------------------
# 無効時は全 API が 404、画面の導線も出ない
FOLDER_ACCESS_ENABLED=false
# 検証専用: 貸与情報を確認できなくても担当者の指定端末で進める（NODE_ENV=production では起動拒否）
FOLDER_ACCESS_ALLOW_UNVERIFIED_LEASE=false
# Mirai-Info の PII API（device-staff）。device_staff ビューを SQL で直接読まない
LEASE_API_URL=
# Cloudflare Access サービストークン（ID と Secret は別の値。未設定なら LEASE_UNAVAILABLE で留まる）
LEASE_API_TOKEN_ID=
LEASE_API_TOKEN_SECRET=
# 貸与情報の鮮度（dataAsOf.employeeDirectoryLastSeenAt）がこの時間より古ければ確定しない
LEASE_MAX_AGE_HOURS=72
# 同意の終了からこの日数を過ぎた行の識別子（SID・端末など）を消す。状態・終了理由・時刻と監査は残す
FOLDER_ACCESS_RETENTION_DAYS=30
