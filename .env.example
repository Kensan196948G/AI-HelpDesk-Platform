# アプリ設定（MVP）。実際の値は `.env.local`（Git 管理外）に置く。
NODE_ENV=development
PORT=18950
HOST=127.0.0.1

# Local PostgreSQL（専用 DB）。既存 DB は変更しない。
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5435/ai_helpdesk_mvp

# セッション署名/トークン用（十分な長さのランダム値）
SESSION_SECRET=replace-with-64-hex
# Worker → API の共有秘密（Worker Secret と一致させる）
PROXY_SECRET=replace-with-48-hex

# Seed 用のデモパスワード（リポジトリへコミットしない）
SEED_PASSWORD=replace-with-demo-password

# ブラウザの Origin（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Preview（HTTPS）では true
COOKIE_SECURE=false
LOG_LEVEL=info
