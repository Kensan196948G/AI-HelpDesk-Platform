# アプリ設定（MVP）。実際の値は `.env.local`（Git 管理外）に置く。
NODE_ENV=development
PORT=18950
HOST=127.0.0.1

# Local PostgreSQL（専用 DB）。既存 DB は変更しない。
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5435/ai_helpdesk_mvp

# セッション署名/トークン用（十分な長さのランダム値）
SESSION_SECRET=replace-with-64-hex
# Worker → API の共有秘密（Worker Secret と一致させる）
PROXY_SECRET=replace-with-48-hex

# Seed 用のデモパスワード（リポジトリへコミットしない）
SEED_PASSWORD=replace-with-demo-password

# ブラウザの Origin（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Preview（HTTPS）では true
COOKIE_SECURE=false
LOG_LEVEL=info

# 認証: local（開発/テスト） / cloudflare-access（本番・Preview）
AUTH_MODE=local
DEV_AUTH_EMAIL=dev@example.com
# アクセス許可リストの正本（完全一致メール / @domain。repo ルート相対）
# Cloudflare Access の allow ポリシーと同じ内容にすること。
ACCESS_ALLOWLIST_FILE=docs/MailAddress.txt
# 「操作する人」の切替を許可するメール（カンマ区切り）。
# cloudflare-access（本番）では既定で本人以外に切り替えられない。デモ用だけ列挙する。
PERSONA_SWITCH_ALLOWLIST=
# 同一人物のメール別名（カンマ区切り `alias=primary`）。
# 例: Cloudflare Access で Gmail と会社アドレスを使い分ける人がいても、
# 状態・切替権限・名簿照合を primary に揃える。
EMAIL_ALIASES=


# Cloudflare Access の JWT 検証: off / report（ログのみ） / enforce（不正なら 401）
ACCESS_JWT_MODE=off
# 例: <team>.cloudflareaccess.com（Access のチームドメイン）
ACCESS_TEAM_DOMAIN=
# Access アプリケーションの AUD タグ（秘密ではない）
ACCESS_AUD=

# DeepSeek API（MVP / Staging のみ。リポジトリへ書かない）
DEEPSEEK_API_KEY=
# DeepSeek-V4.1-Flash（API モデル ID: deepseek-flash）
DEEPSEEK_MODEL=deepseek-flash
# 一次回答の速度/安定性を優先する場合は disabled。推論を使う場合は enabled。
DEEPSEEK_THINKING=disabled
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=30000

# 最終報告書の PDF 生成（ヘッドレス Chrome）。通常は自動検出するため空でよい。
# 例: /usr/bin/google-chrome
REPORT_PDF_BIN=
REPORT_PDF_TIMEOUT_MS=30000
